{
  "name": "wmcoach",
  "version": "0.2.2",
  "private": true,
  "description": "Walter's coaching PWA (offline-first, GitHub Pages)",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\" \"tests/migration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:migration": "node --test \"tests/migration/*.test.js\"",
    "e2e": "node tests/e2e/run.mjs",
    "serve": "node scripts/serve.mjs",
    "build:program": "node scripts/build_program.mjs",
    "seed:model": "node scripts/seed_model.mjs",
    "fixture": "node scripts/make_fixture.mjs",
    "icons": "node scripts/make_icons.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.0.0",
    "playwright": "1.56.1"
  }
}
